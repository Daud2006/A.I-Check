APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use SMTP (for example Mailtrap or Gmail App Password) to deliver password reset OTPs.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, and use an App Password.
# Mailtrap: MAIL_HOST=sandbox.smtp.mailtrap.io and MAIL_PORT=2525.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
AUTH_PASSWORD_RESET_EXPIRE=5
AUTH_PASSWORD_RESET_THROTTLE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Server-side Hugging Face Inference Providers credentials; never expose via Vite.
HF_TOKEN=
HF_IMAGE_MODEL=Organika/sdxl-detector
HF_IMAGE_TIMEOUT=60

# Optional persistent local AI worker. Keep the bearer secret server-side.
AI_WORKER_ENABLED=false
AI_WORKER_URL=http://127.0.0.1:8765
AI_WORKER_SECRET=
AI_WORKER_CONNECT_TIMEOUT=2
AI_WORKER_HEALTH_TIMEOUT=3
AI_WORKER_TIMEOUT=50
AI_WORKER_SUBPROCESS_FALLBACK=false
